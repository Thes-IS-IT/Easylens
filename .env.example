# EasyLens Environment Variables Sample (.env.example)

# Gemini AI API Keys
GEMINI_API_KEY=your_gemini_api_key

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=easylens-a6191
FIREBASE_STORAGE_BUCKET=easylens-a6191.firebasestorage.app

# Cloudflare R2 & D1 Configuration
D1_DTABASE=your_d1_database_id
ACCOUNT_ID=your_cloudflare_account_id
S3_API=https://<account_id>.r2.cloudflarestorage.com/easylens
ACCESS_KEY_ID=your_r2_access_key
SECRET_ACCESS_KEY=your_r2_secret_key
BUCKET_NAME=easylens

# Google Maps API Key
GOOGLE_MAPS_KEY=your_google_maps_key

# MensaHero SMS Gateway Configuration
MENSAHERO_API_KEY=your_mensahero_key
MENSAHERO_BASE_URL=https://mensahero.onrender.com

# Notion API Configuration (for Settings Feedback Integration)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
